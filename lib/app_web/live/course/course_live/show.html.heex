<.header>
  Course <%= @course.id %>
  <:subtitle>This is a course record from your database.</:subtitle>
  <:actions>
    <.link patch={~p"/course/courses/#{@course}/show/edit"} phx-click={JS.push_focus()}>
      <.button>Edit course</.button>
    </.link>
  </:actions>
</.header>

<.list>
  <:item title="Title"><%= @course.title %></:item>
  <:item title="Description"><%= @course.description %></:item>
  <:item title="Text"><%= @course.text %></:item>
  <:item title="Image"><%= @course.image %></:item>
  <:item title="Video"><%= @course.video %></:item>
  <:item title="Date"><%= @course.date %></:item>
</.list>

<.back navigate={~p"/course/courses"}>Back to courses</.back>

<.modal :if={@live_action == :edit} id="course-modal" show on_cancel={JS.patch(~p"/course/courses/#{@course}")}>
  <.live_component
    module={AppWeb.Course.CourseLive.FormComponent}
    id={@course.id}
    title={@page_title}
    action={@live_action}
    course={@course}
    patch={~p"/course/courses/#{@course}"}
  />
</.modal>
